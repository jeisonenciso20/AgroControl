# --- Database -----------------------------------------------------------------
# Neon: run `neon deploy` in this folder to pull DATABASE_URL (pooled) and
# DATABASE_URL_UNPOOLED (direct, used by Prisma Migrate) into .env automatically.
# Local Docker: both values can point at the same local Postgres.
DATABASE_URL=postgresql://agro:agro_secret@localhost:5432/agrocontrol?schema=public
DATABASE_URL_UNPOOLED=postgresql://agro:agro_secret@localhost:5432/agrocontrol?schema=public
# Set by `neon deploy`; informational only.
NEON_BRANCH=production

# --- Auth ---------------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# --- HTTP ---------------------------------------------------------------------
PORT=3000
CORS_ORIGIN=*
